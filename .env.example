# Copy this file to `.env` (same folder) and fill in your values.
# `.env` is ignored by git, so your copy is never uploaded.
#
# Find both in the Supabase dashboard: Project Settings > API.
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = the key labelled "anon" / "public" (publishable)
#
# NEVER put the "service_role" (secret) key here or anywhere in this repo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
